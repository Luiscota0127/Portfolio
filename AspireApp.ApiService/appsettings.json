{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=aspireapp.db"
  },
  "Jwt": {
    "Key": "ReplaceThisWithASecretKeyForDev",
    "Issuer": "AspireApp",
    "Audience": "AspireAppClients",
    "TokenLifetimeMinutes": 60
  }
}
