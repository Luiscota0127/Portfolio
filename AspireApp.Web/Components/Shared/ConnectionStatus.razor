@using AspireApp.Web.Services
@inject CollaborationService Collab

<div class="connection-status">
    @if (state == CollaborationService.ConnectionState.Connected)
    {
        <span class="badge bg-success">Connected</span>
    }
    else if (state == CollaborationService.ConnectionState.Reconnecting)
    {
        <span class="badge bg-warning">Reconnecting...</span>
    }
    else
    {
        <span class="badge bg-danger">Disconnected</span>
    }
</div>

@code{
    private CollaborationService.ConnectionState state = CollaborationService.ConnectionState.Disconnected;

    protected override async Task OnInitializedAsync()
    {
        Collab.OnConnectionChanged += OnConnChanged;
        await Collab.StartAsync();
    }

    private Task OnConnChanged(CollaborationService.ConnectionState s)
    {
        state = s;
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Collab.OnConnectionChanged -= OnConnChanged;
    }
}
